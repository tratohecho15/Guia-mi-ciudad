let selectedCat="";function card(b,offer=false){return `<article class="biz"><div class="biz-art ${b.color}">${b.icon}${b.ad?'<span class="adtag">DESTACADO</span>':''}</div><div class="biz-body"><div class="biz-meta"><span>${b.cat}</span><span>${b.loc}</span></div><h3>${b.name}</h3><p>${b.desc}</p><div class="biz-bottom"><button class="smallbtn solid" onclick="openModal(${b.id},${offer})">Ver ficha</button><button class="smallbtn" onclick="showPage('anunciar')">Anunciarme</button></div></div></article>`}
function render(){const q=document.getElementById('q').value.trim().toLowerCase(),loc=document.getElementById('localidad').value,cat=document.getElementById('rubroseleccion').value||selectedCat;const filtered=businesses.filter(b=>(!q||(b.name+' '+b.cat+' '+b.loc+' '+b.desc).toLowerCase().includes(q))&&(!loc||b.loc===loc||loc==="Otra zona del partido")&&(!cat||b.cat===cat));document.getElementById('businesses').innerHTML=filtered.map(b=>card(b)).join('');document.getElementById('empty').style.display=filtered.length?'none':'block';document.getElementById('count').textContent=filtered.length+' ejemplos de muestra · No son comercios verificados.';document.querySelectorAll('.cat').forEach(x=>x.classList.toggle('active',x.dataset.cat===selectedCat))}function renderOffers(){document.getElementById('offers').innerHTML=offers.map(b=>card(b,true)).join('')}function showPage(page){document.querySelectorAll('.page').forEach(p=>p.classList.remove('active'));document.getElementById('page-'+page).classList.add('active');document.querySelectorAll('.nav button').forEach(b=>b.classList.toggle('active',b.dataset.page===page));window.scrollTo({top:0,behavior:'smooth'})}document.querySelectorAll('.nav button').forEach(b=>b.addEventListener('click',()=>showPage(b.dataset.page)));document.getElementById('search').addEventListener('click',render);document.getElementById('q').addEventListener('input',render);document.getElementById('localidad').addEventListener('change',render);document.getElementById('rubroseleccion').addEventListener('change',()=>{selectedCat=document.getElementById('rubroseleccion').value;render()});document.querySelectorAll('.cat').forEach(b=>b.addEventListener('click',()=>{selectedCat=b.dataset.cat;document.getElementById('rubroseleccion').value=selectedCat;render()}));function openModal(id,offer){const b=(offer?offers:businesses).find(x=>x.id===id)||businesses.find(x=>x.id===id)||offers.find(x=>x.id===id);if(!b)return;document.getElementById('modal-title').textContent=b.name;document.getElementById('modal-desc').textContent=b.desc;document.getElementById('modal-meta').textContent=b.cat+' · '+b.loc;document.getElementById('modalback').classList.add('open')}function closeModal(){document.getElementById('modalback').classList.remove('open')}document.getElementById('modalback').addEventListener('click',e=>{if(e.target.id==='modalback')closeModal()});function choosePlan(plan){showPage('anunciar');document.getElementById('planform').value=plan;document.getElementById('nombre').focus()}let preparedText='';document.getElementById('adform').addEventListener('submit',e=>{e.preventDefault();const val=id=>document.getElementById(id).value.trim();preparedText=`SOLICITUD DE PUBLICIDAD — GUÍA DE MI CIUDAD\nNombre: ${val('nombre')}\nNegocio: ${val('negocio')}\nContacto: ${val('contacto')}\nLocalidad: ${val('zonaform')}\nPlan: ${val('planform')}\nDetalle: ${val('detalle')||'Sin detalle adicional'}\n\nSolicitud generada desde la versión de demostración.`;const r=document.getElementById('formresult');r.textContent=preparedText;r.style.display='block';document.getElementById('copyresult').style.display='inline-block'});document.getElementById('copyresult').addEventListener('click',async()=>{try{await navigator.clipboard.writeText(preparedText);document.getElementById('copyresult').textContent='Solicitud copiada ✓'}catch(e){const ta=document.createElement('textarea');ta.value=preparedText;document.body.appendChild(ta);ta.select();document.execCommand('copy');ta.remove();document.getElementById('copyresult').textContent='Solicitud copiada ✓'}});render();renderOffers();
</script></body></html>
